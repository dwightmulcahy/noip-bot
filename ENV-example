# ===============================================
# Put secrets here, do not hard code your secrets
# ===============================================

# to debug or not to debug, that is this setting
DEBUG=True

# Run Chrome headless (invisible). Defaults to true. Set false only if you
# need to visually watch a run for debugging.
HEADLESS=True

# Where debug/error screenshots get written. Defaults to the current
# directory; set this to persist them to a mounted volume in Docker.
SCREENSHOT_DIR=.

# webpage bindings
BIND_ADDR=127.0.0.1
PORT=80

# Gmail account used to SEND notification emails from the bot
GMAIL_ID="your.gmail.addr.here@gmail.com"
GMAIL_TOKEN="**your-token-here**"

# Gmail account that RECEIVES noip.com's 2FA verification-code emails —
# this is the inbox tied to your noip.com account, which may be a
# different Gmail account than the one the bot sends notifications from.
NOIP_VERIFICATION_EMAIL="your-noip-account-email@gmail.com"
NOIP_VERIFICATION_EMAIL_TOKEN="**your-token-here**"

# noip.com logon info
NOIP_ID="noip-userid"
NOIP_PASSWORD="noip-password"

# How many days before a host's 30-day free-hostname mark to schedule the
# next check. Self-calibrates: if a check finds a host isn't actually
# confirmable yet despite being within this buffer, it retries daily
# (with a warning) until it is, then adopts the observed value from then on.
CONFIRM_BUFFER_DAYS=5

