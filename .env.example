# ===============================================
# Put secrets here, do not hard code your secrets
# ===============================================

# to debug or not to debug, that is this setting
DEBUG=False

# webpage bindings
BIND_ADDR=0.0.0.0
PORT=8080
TZ=America/Costa_Rica
SCREENSHOT_DIR=/app/data/screenshots
STATE_FILE=/app/data/state.json
RUN_LOCK_FILE=/app/data/renewal.run.lock
LOG_LEVEL=INFO
HEADLESS=true
CHROMEDRIVER_BIN=/usr/bin/chromedriver
CHROMEDRIVER_LOG=/app/data/chromedriver.log
HEALTH_OVERDUE_GRACE_SECONDS=3600
# Generate with: openssl rand -hex 32
# Required for / and /status.json; must contain at least 32 characters.
STATUS_TOKEN=""
DRY_RUN=false
SKIP_INITIAL_RUN=false
APP_VERSION=0.0.0-dev
MAX_CHECK_INTERVAL_DAYS=5
NOTIFICATION_TIMEOUT_SECONDS=30

# Gmail account used to SEND notification emails from the bot
GMAIL_ID="your.gmail.addr.here@gmail.com"
GMAIL_TOKEN=""

# Gmail account that RECEIVES noip.com's 2FA verification-code emails —
# this is the inbox tied to your noip.com account, which may be a
# different Gmail account than the one the bot sends notifications from.
NOIP_VERIFICATION_EMAIL="your-noip-account-email@gmail.com"
NOIP_VERIFICATION_EMAIL_TOKEN=""

# noip.com logon info
NOIP_ID=""
NOIP_PASSWORD=""
